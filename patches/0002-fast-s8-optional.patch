+def _fast_sigma8(omega_c, omega_b, h, n_s, m_nu, A_s):
+    """Approximate linear sigma8 for the optional fast S8 normalisation.
+
+    Direct CAMB at AccuracyBoost=IntTolBoost=0.5 is about 10x faster than a
+    full pyccl transfer.  Its bias relative to pyccl reaches 4.9e-3 over the
+    prior corners, so this path is opt-in (``fast_s8=True``) and off by default.
+    """
+    params = camb.CAMBparams()
+    params.set_cosmology(
+        H0=100 * h, ombh2=omega_b, omch2=omega_c, mnu=m_nu, nnu=3.046
+    )
+    params.set_accuracy(AccuracyBoost=0.5)
+    params.Accuracy.IntTolBoost = 0.5
+    params.InitPower.set_params(As=A_s, ns=n_s)
+    params.WantCls = False
+    params.set_matter_power(
+        redshifts=[0.0], kmax=10.0, nonlinear=False, silent=True
+    )
+    return float(camb.get_results(params).get_sigma8_0())
 
